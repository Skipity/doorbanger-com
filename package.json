{
  "name": "doorbangers-com",
  "version": "1.0.0",
  "private": true,
  "description": "DoorBangers, built with HTML and locally compiled Tailwind CSS.",
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./assets/site.css --minify",
    "watch": "tailwindcss -i ./src/styles.css -o ./assets/site.css --watch",
    "dev": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0"
  }
}
